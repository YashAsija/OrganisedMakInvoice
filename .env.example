# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_BACKEND_URL: The public URL of the FastAPI backend.
# Used by the frontend for server-side PIN verification (POST /api/auth/pin/verify).
# If not set, BiometricVerification falls back to local PBKDF2 hash (offline mode).
# For local dev: http://localhost:8000
# For production: same as APP_URL (if frontend and backend are co-hosted)
NEXT_PUBLIC_BACKEND_URL="https://YOUR_BACKEND_URL"


# -------------------------------------------------------------------
# Backend scheduler — set these in your Cloud Run / hosting environment
# -------------------------------------------------------------------

# SUPABASE_URL: Your Supabase project REST endpoint (no trailing slash).
# Same value as NEXT_PUBLIC_SUPABASE_URL but without the NEXT_PUBLIC_ prefix
# so it's accessible in the Python backend (which doesn't have access to Next.js env).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Found in Supabase Dashboard → Settings → API.
# The service role key bypasses Row Level Security so the scheduler can read
# invoices belonging to ALL users, not just the authenticated request user.
# ⚠️  Never expose this key to the browser/frontend.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# SCHEDULER_SECRET: A strong random string (e.g. 32 hex chars) that protects
# the POST /api/jobs/recurring-invoices endpoint.
# Pass it as the X-Scheduler-Secret header when calling the endpoint from a
# cron service (e.g. pg_cron, GitHub Actions, or an external scheduler).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SCHEDULER_SECRET="YOUR_STRONG_RANDOM_SCHEDULER_SECRET"
